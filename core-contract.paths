# Core contract: byte-identical in mobius-api and mobius-lite-api; change both or neither.
# One path (file) or directory (compared recursively, added/removed files included)
# per line, relative to the repo root; '#' starts a comment. Checked by
# scripts/check-core-contract.sh and, at deploy, by the deploy script (working trees).
# Rule of thumb: whatever reads or writes a CORE-plane table (src/database/ownership.ts),
# or decides which tenant an API process may open, belongs here. Tenant-only
# business code does not.

# The contract itself
core-contract.paths
scripts/check-core-contract.sh
src/common/config/product.ts

# Core schema and seeds (one shared core database)
migrations/core/
seeds/core/
src/__tests__/unit/core-migrations.test.ts
src/__tests__/unit/helpers/contract-ddl.ts


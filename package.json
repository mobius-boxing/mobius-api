{
  "name": "mobius-api-v2",
  "version": "1.0.0",
  "description": "backend project generated by Paul Sundays",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest",
    "start": "node dist/server.js",
    "build": "tsc --skipLibCheck || exit 0",
    "start:dev": "nodemon src/server.ts",
    "format": "prettier --write .",
    "create:controller": "sundaysf --create-controller",
    "migrate:create": "knex migrate:make --knexfile knexfile.ts",
    "migrate:deploy": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "seed:create": "knex seed:make --knexfile knexfile.ts",
    "seed:run": "knex seed:run --knexfile knexfile.ts",
    "deploy": "bash ../debug/deploy-backend.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-ses": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@sendgrid/mail": "^8.1.4",
    "@sundaysf/utils": "^0.0.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@sundaysf/cli": "^0.2.11",
    "@types/bcryptjs": "^2.4.6",
